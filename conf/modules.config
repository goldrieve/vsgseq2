/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [ enabled: false ]
    maxForks   = params.forks

    withLabel: 'process_single|process_low|process_medium|process_high' {
        memory = null
    }

    withName: 'TRIM' {
        cpus = { params.cores }
        publishDir = [
            path: { "${params.outdir}/trimmed" },
            mode: params.publish_dir_mode,
            pattern: '*_trimmed*.fq.gz'
        ]
    }

    withName: 'ASSEMBLE' {
        cpus = { params.cores }
        memory = { "${params.trinitymem} GB" }
        publishDir = [
            path: { "${params.outdir}/assemblies" },
            mode: params.publish_dir_mode,
            pattern: '*_trinity.Trinity.fasta'
        ]
    }

    withName: 'BLAST' {
        publishDir = [
            path: { "${params.outdir}/VSGs" },
            mode: params.publish_dir_mode,
            pattern: '*_VSGs.fasta'
        ]
    }

    withName: 'CONCATENATE_VSGS' {
        publishDir = [
            path: { "${params.outdir}/VSGs" },
            mode: params.publish_dir_mode,
            pattern: '*.fasta'
        ]
    }

    withName: 'CONCATENATED_CDHIT' {
        publishDir = [
            path: { "${params.outdir}/VSGs/VSGome" },
            mode: params.publish_dir_mode,
            pattern: 'VSGome.fasta*'
        ]
    }

    withName: 'INDEX' {
        cpus = { params.cores }
    }

    withName: 'QUANTIFY' {
        cpus = { params.cores }
    }

    withName: 'MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode,
            pattern: 'multiqc_*'
        ]
    }

    withName: 'SUMMARISE' {
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                def subdirs = [
                    'tpm.csv'                          : 'tpm',
                    'filtered_tpm.csv'                 : 'tpm',
                    'cluster_tpm.csv'                  : 'tpm',
                    'num_reads.csv'                    : 'read_counts',
                    'total_read_counts.csv'            : 'read_counts',
                    'vsg_count.csv'                    : 'vsgs',
                    'length.csv'                       : 'length',
                    'filtered_tpm_clusters.csv'        : 'cluster',
                    'filtered_tpm_clusters_length.csv' : 'cluster',
                    'cluster_champion.csv'             : 'cluster',
                    'champion_vsgs.fasta'              : 'cluster',
                ]
                subdirs[filename] ? "${subdirs[filename]}/${filename}" : null
            }
        ]
    }
}
