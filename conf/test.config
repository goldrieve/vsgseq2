/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
    Samplesheet paths are relative, so run from the repository root.

    Use as follows:
        nextflow run main.nf -profile test,<conda/docker/singularity/apptainer> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    // Input data
    samplesheet = "${projectDir}/tests/data/samples.csv"
    cores       = 2
    trinitymem  = 8
}
