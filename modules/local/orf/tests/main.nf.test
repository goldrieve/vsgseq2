nextflow_process {

    name "Test Process ORF"
    script "../main.nf"
    process "ORF"

    test("Should predict ORFs") {

        when {
            process {
                """
                input[0] = [ [ id: 'latesingle' ], file("${projectDir}/tests/data/latesingle_trinity_cdhit.fasta", checkIfExists: true) ]
                input[1] = 300
                input[2] = false
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
