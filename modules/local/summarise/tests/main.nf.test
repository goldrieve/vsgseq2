nextflow_process {

    name "Test Process SUMMARISE"
    script "../main.nf"
    process "SUMMARISE"

    test("Should run summary steps") {

        when {
            process {
                """
                input[0] = channel.fromPath(["${projectDir}/tests/data/early_1_quant", "${projectDir}/tests/data/late_1_quant"]).collect()
                input[1] = 100000
                input[2] = channel.fromPath("${projectDir}/tests/data/latesingle_ORF_VSGs.fasta").collect()
                input[3] = file("${projectDir}/tests/data/VSGome.fasta.clstr", checkIfExists: true)
                input[4] = file("${projectDir}/tests/data/VSGome.fasta", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
