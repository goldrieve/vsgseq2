/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    goldrieve/vsgseq2 Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

params {

    // Input options
    samplesheet                = null
    today                      = new Date().format('ddMMMYY')
    mode                       = 'full'
    assemblies                 = "${projectDir}/data/tutorial_assemblies/*_trinity.Trinity.fasta"

    // Reference options
    vsg_db                     = "${projectDir}/data/blastdb/concatAnTattb427.fa"
    notvsg_db                  = "${projectDir}/data/blastdb/vsgseq2NOTvsgs.fa"
    full_vsg_db                = null
    genome                     = "${projectDir}/data/genome/TriTrypDB-67_TbruceiEATRO1125_Genome.fasta"
    decoys                     = "${projectDir}/data/genome/TriTrypDB-67_TbruceiEATRO1125_Genome_decoys.txt"

    // Analysis options
    cdslength                  = 300
    partial                    = false
    cdhit_id                   = 0.94
    cdhit_as                   = 0.94
    threshold                  = 100000

    // Resource options
    cores                      = 4
    trinitymem                 = 20
    forks                      = 5

    // Boilerplate options
    outdir                       = "results/${params.today}"
    publish_dir_mode             = 'copy'
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    trace_report_suffix          = java.time.LocalDateTime.now().format(java.time.format.DateTimeFormatter.ofPattern('yyyy-MM-dd_HH-mm-ss'))

    validate_params            = true
}

outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

includeConfig 'conf/base.config'

includeConfig 'conf/modules.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        conda.cacheDir          = System.getenv('NXF_CONDA_CACHEDIR') ?: "${projectDir}/conda-cache"
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        conda.channels          = ['conda-forge', 'bioconda']
        conda.cacheDir          = System.getenv('NXF_CONDA_CACHEDIR') ?: "${projectDir}/conda-cache"
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        singularity.cacheDir    = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${projectDir}/singularity-cache"
        singularity.pullTimeout = '60 min'
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        apptainer.cacheDir      = System.getenv('NXF_APPTAINER_CACHEDIR') ?: "${projectDir}/apptainer-cache"
        apptainer.pullTimeout   = '60 min'
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    test      { includeConfig 'conf/test.config'      }
}

apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
singularity.registry  = 'quay.io'

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}

process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'goldrieve/vsgseq2'
    contributors    = [
        [
            name: 'Guy Oldrieve',
            github: 'goldrieve',
            contribution: ['author', 'maintainer'],
        ],
    ]
    homePage        = 'https://github.com/goldrieve/vsgseq2'
    description     = """Assembly, identification and quantification of VSGs from VSG-seq data"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=26.04.0'
    version         = '2.0.0dev'
    doi             = ''
}

plugins {
    id 'nf-schema@3.0.0' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
}
